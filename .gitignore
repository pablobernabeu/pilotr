# generated demo output
build/

# python
__pycache__/
*.pyc
.pytest_cache/
# coverage.py's data file and its JSON report, which pytest's --cov flags write to
# the directory the suite runs from. The pytest job in python-tests.yml passes
# those flags, so a local run that copies its command should not leave them
# staged for a commit
.coverage
coverage.json
*.egg-info/
dist/
.venv/
python/site/

# R
.Rhistory
.RData
*.Rproj.user

# R package build artifacts
r/pilotr/vignettes/*.knit.md
r/pilotr/vignettes/*.html
r/pilotr/vignettes/*_files/
r/pilotr/doc/
r/pilotr/Meta/
r/pilotr/docs/

# The site workflow's working directories at the repository root. app-stage/
# holds the app's sources staged for shinylive::export(), and site/ is the
# published website: the landing and not-found pages, the two documentation
# sites, the exported app and the redirect stubs. Anyone reproducing the build
# locally ends up with both in the tree.
/site/
/app-stage/


# Generated cross-language parity dumps; the harness is source, its output is not
tools/parity/out/

# The HPC job's task logs, which SLURM writes to hpc/, where the job is submitted from
hpc/slurm-*.out
