cff-version: 1.2.0
message: "If you use pilotr, please cite it as below."
title: "pilotr: Simulate experimental and behavioural data from a portable design specification"
abstract: "Generative simulation of experimental and behavioural data from a portable JSON design specification shared by a no-code app, an R package and a Python package, with simulation-based power and precision/ROPE design analysis and a shared cross-language random-number generator that makes the simulated data bit-identical across implementations wherever they share a maths library."
type: software
authors:
  - family-names: Bernabeu
    given-names: Pablo
    orcid: "https://orcid.org/0000-0003-1083-2460"
    email: pcbernabeu@gmail.com
# Neither field is generated from anything, so both are set by hand at each release. The R
# and Python packages are released separately, and this file follows the newest release of
# either, with the date it first became public (on CRAN or PyPI). tools/check_versions.py
# fails CI when the version is not the newer of the two package versions.
# First public on CRAN, 2026-09-20 (R package, while PyPI stays at 0.3.0).
version: "0.3.1"
date-released: "2026-09-20"
# This file describes the repository, which holds both packages, so its DOI is Zenodo's
# concept DOI, which archives every GitHub release of both and favours neither. Each
# package's own citation gives that package's identifier: the R package's gives the DOI CRAN
# assigned to it, and the Python package's gives this one, since PyPI assigns no DOI.
doi: "10.5281/zenodo.21266313"
# Each identifier, marked with the package it names. CFF's repository-artifact holds a
# single address, which would favour one distribution, so CRAN and PyPI are both listed here
# instead.
identifiers:
  - type: doi
    value: "10.5281/zenodo.21266313"
    description: "Both packages: every GitHub release of the repository, archived on Zenodo. The Python package's citation gives this DOI."
  - type: doi
    value: "10.32614/CRAN.package.pilotr"
    description: "The R package: the DOI CRAN assigned to it, across all its versions. The R package's citation gives this DOI."
  - type: url
    value: "https://CRAN.R-project.org/package=pilotr"
    description: "The R package on CRAN."
  - type: url
    value: "https://pypi.org/project/pilotr/"
    description: "The Python package on PyPI."
license: MIT
repository-code: "https://github.com/pablobernabeu/pilotr"
url: "https://pablobernabeu.github.io/pilotr/"
keywords:
  - simulation
  - power analysis
  - mixed-effects models
  - experimental design
  - reproducible research
