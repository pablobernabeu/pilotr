bibentry(
  bibtype = "Manual",
  title   = "pilotr: Simulate experimental and behavioural data from a portable design specification",
  author  = person("Pablo", "Bernabeu", comment = c(ORCID = "0000-0003-1083-2460")),
  year    = "2026",
  note    = sprintf("R package version %s", meta$Version),
  doi     = "10.5281/zenodo.21266313",
  url     = "https://doi.org/10.5281/zenodo.21266313",
  textVersion = sprintf(paste0(
    "Bernabeu, P. (2026). pilotr: Simulate experimental and behavioural data ",
    "from a portable design specification. R package version %s. ",
    "https://doi.org/10.5281/zenodo.21266313"
  ), meta$Version)
)
